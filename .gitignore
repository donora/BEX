# Local config (copy bex.example.toml -> bex.toml)
bex.toml

# Hot-tier data — regenerable, never committed
store/
cache/

# Virtual environments (app env here; runner envs under envs/*/)
.venv/
envs/*/.venv/

# Data that must never land in the repo (PLAN.md §8 rule 4)
data/audio
*.flac
*.wav
*.mp3

# Python
__pycache__/
*.egg-info/
.pytest_cache/

# uv lockfile: the documented install is pip; a stale lock would mislead
uv.lock

# Build output (python -m build)
dist/

# Tour screenshot tooling: its npm install and raw captures
scripts/tour/node_modules/
scripts/tour/package*.json
scripts/tour/raw/

# Local model checkpoint pointer for the birdsong runner
envs/birdsong/checkpoint.txt
